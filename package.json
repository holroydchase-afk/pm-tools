{
  "name": "pm-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Chase Holroyd's product management tools: app sources, generic PM templates, and a sample-data demo build.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.ts\" && bash tests/persona-check.test.sh && bash scripts/check-agents.sh",
    "typecheck": "tsc -p .",
    "build": "node scripts/build-demo.ts",
    "check:private": "node scripts/check-private.ts",
    "feed": "node scripts/build-feed.ts",
    "feed:sample": "node scripts/build-sample-feed.ts",
    "hooks": "git config core.hooksPath .githooks",
    "test:e2e": "node --test \"tests/e2e/*.e2e.ts\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.0.0",
    "playwright": "1.65.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
