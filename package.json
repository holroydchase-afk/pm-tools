{
  "name": "pm-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Chase Holroyd's product management tools: app sources, generic PM templates, and a sample-data demo build.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.ts\" && bash tests/persona-check.test.sh && bash scripts/check-agents.sh",
    "typecheck": "tsc -p .",
    "build": "node scripts/build-demo.ts",
    "check:private": "node scripts/check-private.ts",
    "hooks": "git config core.hooksPath .githooks",
    "test:e2e": "node --test \"tests/e2e/*.e2e.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  }
}
